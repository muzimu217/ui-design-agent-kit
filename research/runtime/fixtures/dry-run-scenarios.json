{
  "schemaVersion": 1,
  "description": "Fixed C0/C1 dry-run scenarios for the research instrument core. Synthetic pilot labels only; no network, model, or real participant data. Dry-run outputs never count as participant evidence.",
  "studyId": "uak-formative-v1",
  "assignment": {
    "participantIds": ["dryrun-pilot-a", "dryrun-pilot-b"],
    "taskIds": ["T1", "T2"],
    "seed": "dry-run-v1"
  },
  "runs": [
    {
      "condition": "C0",
      "participantId": "dryrun-pilot-a",
      "taskId": "T1",
      "taskCard": "# Task T1 — Build an operations dashboard (M)\n\nDry-run task card. The brief, stimulus materials, and acceptance criteria\nare placeholders for the instrument self-test only; the P2 gate freezes the\nreal task cards before any human session.\n\n- C0: free execution, no gates. The agent executes the task card directly.\n- Evidence: session log, timing marks, and this run directory manifest.\n",
      "timingMarks": [
        { "label": "session_started", "offsetMs": 0 },
        { "label": "execution_started", "offsetMs": 1500 },
        { "label": "execution_completed", "offsetMs": 152000 },
        { "label": "session_ended", "offsetMs": 155000 }
      ],
      "events": [
        { "actor": "runner", "type": "session_started", "payload": {} },
        { "actor": "runner", "type": "timer_started", "payload": { "label": "free_execution" } },
        { "actor": "agent", "type": "artifact_saved", "payload": { "path": "output/dashboard.html" } },
        { "actor": "runner", "type": "timer_stopped", "payload": { "label": "free_execution" } },
        { "actor": "runner", "type": "execution_completed", "payload": {} },
        { "actor": "agent", "type": "artifact_saved", "payload": { "path": "evidence/summary.md" } },
        { "actor": "runner", "type": "session_ended", "payload": {} }
      ]
    },
    {
      "condition": "C1",
      "participantId": "dryrun-pilot-a",
      "taskId": "T2",
      "taskCard": "# Task T2 — Build a dense standards ledger (M)\n\nDry-run task card. The brief, stimulus materials, and acceptance criteria\nare placeholders for the instrument self-test only; the P2 gate freezes the\nreal task cards before any human session.\n\n- C1: gated execution. The agent drafts intent, searches materials, and\n  collects evidence behind GATE1/GATE2/GATE3; only the user may approve.\n- Evidence: session log with three user gate decisions, timing marks, and\n  this run directory manifest.\n",
      "timingMarks": [
        { "label": "session_started", "offsetMs": 0 },
        { "label": "gate1_decision", "offsetMs": 42000 },
        { "label": "gate2_decision", "offsetMs": 98000 },
        { "label": "execution_started", "offsetMs": 99000 },
        { "label": "gate3_decision", "offsetMs": 205000 }
      ],
      "events": [
        { "actor": "runner", "type": "session_started", "payload": {} },
        { "actor": "agent", "type": "intent_updated", "payload": { "text": "Standards ledger with density-first tables and a strict typographic scale." } },
        { "actor": "agent", "type": "gate_request", "payload": { "gate": "GATE1" } },
        { "actor": "user", "type": "gate_decision", "payload": { "gate": "GATE1", "decision": "approve" } },
        { "actor": "agent", "type": "material_selected", "payload": { "refs": ["material/table-density", "material/typographic-scale"] } },
        { "actor": "agent", "type": "gate_request", "payload": { "gate": "GATE2" } },
        { "actor": "user", "type": "gate_decision", "payload": { "gate": "GATE2", "decision": "approve" } },
        { "actor": "runner", "type": "execution_started", "payload": {} },
        { "actor": "agent", "type": "artifact_saved", "payload": { "path": "output/ledger.html" } },
        { "actor": "runner", "type": "execution_completed", "payload": {} },
        { "actor": "agent", "type": "gate_request", "payload": { "gate": "GATE3" } },
        { "actor": "user", "type": "gate_decision", "payload": { "gate": "GATE3", "decision": "approve" } }
      ]
    }
  ]
}
