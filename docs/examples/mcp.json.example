{
  "$comment": "Claude Code 项目级 MCP 示例（R135 压力测试崩点 4）：复制到仓库根并改名为 .mcp.json 即可在 Claude Code 中获得与 .codex/config.toml 等价的服务器。仅需下述三项即可跑通主链路；motion_plus/figma/stitch 为可选服务，保持注释状态不启用。带 env 的字段请用你自己的 key，勿提交真实密钥。",
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"],
      "env": {}
    },
    "_motion_plus（可选，未启用）": {
      "url": "https://mcp.motion.dev/plus"
    },
    "_figma（可选，未启用）": {
      "url": "https://mcp.figma.com/mcp"
    },
    "_stitch（可选，未启用）": {
      "url": "https://stitch.googleapis.com/mcp"
    }
  }
}
